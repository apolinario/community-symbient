[Unit]
Description=Feyblet — Community Symbient
After=network.target mosquitto.service docker.service qmd.service lmstudio.service searxng.service
Wants=mosquitto.service qmd.service lmstudio.service searxng.service

[Service]
Type=simple
User=plantoidz
WorkingDirectory=/home/plantoidz/pi/feyblet
EnvironmentFile=/home/plantoidz/pi/feyblet/.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=feyblet

[Install]
WantedBy=multi-user.target
