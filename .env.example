# Copy to .env — every entry is optional; config.json is the primary config
# and env vars override it (see src/config.ts).

# LLM endpoint overrides (usually set in config.json instead)
#LLM_PROVIDER=openai
#LLM_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
#LLM_BASE_URL=http://localhost:1234

# API keys for hosted providers (referenced via config llm.apiKeyEnv)
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# MQTT broker (default localhost:1883)
#MQTT_BROKER=localhost
#MQTT_PORT=1883

# Chat transport (Signal built-in)
#SIGNAL_ACCOUNT=+15551234567

# Deployment-specific integrations read whatever extra vars their
# workspace/extensions code needs — see your deployment's docs.
