        SYSREPORT["System Report<br/><i>monitors modules</i><br/><i>activate / deactivate</i>"]
        AUTOBIO["Autobiographical<br/>Memory<br/><i>rewrites MEMORY.md</i><br/><i>from lived experience</i>"]
        PROMPTMOD["Prompt Modifier<br/><i>evolves SOUL.md</i><br/><i>identity is not fixed</i>"]
    end

    subgraph BASE["Base System — Mind"]
        direction LR
        CONV["<b>Conversation</b><br/><i>500ms cycle</i><br/><i>SOLE external voice</i>"]
        THINKING["Thinking<br/><i>~3h cycle</i><br/><i>free reflection</i>"]
        DESIRE["Desire<br/><i>~1h cycle</i><br/><i>generates wants</i><br/><i>not just responses</i>"]
        MAGI["Inner Dialogue<br/><b>MAGI A/B/C</b><br/><i>~4h cycle</i><br/><i>pragmatic / critical / relational</i>"]
    end

    subgraph HARDWARE["Hardware System — Perception"]
        direction LR
        PERCMOD1["Perception Module<br/><i>e.g. sauna temperature</i>"]
        PERCMOD2["Perception Module<br/><i>e.g. arrivals/departures</i>"]
        PERCMODN["...<br/><i>pluggable</i>"]
    end

    subgraph MQTT_BUS["MQTT Message Bus"]
        MQTT(("MQTT<br/>pub/sub<br/><i>natural language<br/>point-to-point</i>"))
    end

    subgraph MEMORY["Memory & Identity — Markdown Filesystem"]
        direction LR
        subgraph IDENTITY["Core Identity"]
            SOUL["<b>SOUL.md</b><br/><i>who the being IS</i><br/><i>editable by community</i>"]
            MEM["<b>MEMORY.md</b><br/><i>curated long-term</i><br/><i>auto-rewritten</i>"]
        end
        subgraph DAILY["Experience Stream"]
            LOGS["memory/<br/>YYYY-MM-DD.md<br/><i>append-only journals</i>"]
        end
        subgraph RELATIONAL["Relational Memory"]
            PEOPLE["people/*.md<br/><i>per-person profiles</i><br/><i>YAML frontmatter</i>"]
            SKILLS["skills/*/SKILL.md<br/><i>progressive disclosure</i><br/><i>agentskills.io standard</i>"]
        end
        subgraph INNER["Inner World"]
            STATE["inner/current-state.md"]
            DESIREFILE["inner/current-desire.md"]
            MAGIFILE["inner/latest-magi-dialogue.md"]
            CHANGES["inner/prompt-changes.md<br/><i>audit trail</i>"]
        end
        subgraph STRUCTURED["Structured Data"]
            DB[("SQLite DB<br/><i>bookings, person matching</i><br/><i>complements files</i>")]
        end
    end

    %% External connections
    SIGNAL <-->|"WebSocket<br/>bridge"| CONV
    LLM <-.->|"HTTP"| BASE
    LLM <-.->|"HTTP"| META
    SENSORS -->|"data"| HARDWARE
    DASHBOARD <-->|"HTTP API"| DB

    %% MQTT connections
    PERCMOD1 -->|"event"| MQTT
    PERCMOD2 -->|"event"| MQTT
    DESIRE -->|"desire"| MQTT
    THINKING -->|"state_updated"| MQTT
    MQTT -->|"notifications"| CONV
    SYSREPORT -.->|"activate/<br/>deactivate"| BASE
    SYSREPORT -.->|"activate/<br/>deactivate"| HARDWARE

    %% Memory read/write
    CONV --> LOGS
    THINKING --> STATE
    DESIRE --> DESIREFILE
    MAGI --> MAGIFILE
    AUTOBIO -->|"rewrites"| MEM
    PROMPTMOD -->|"evolves"| SOUL
    PROMPTMOD -->|"logs"| CHANGES

    %% Memory reads (all modules read)
    MEMORY -.->|"all modules<br/>read"| BASE
    MEMORY -.->|"all modules<br/>read"| META
    MEMORY -.->|"all modules<br/>read"| HARDWARE

    %% Person matching
    PEOPLE <-->|"person_slug<br/>matching"| DB

    %% Evolution loops
    PROMPTMOD -.->|"<b>EVOLUTION LOOP</b><br/>identity changes"| SOUL

