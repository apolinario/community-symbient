    classDef fast fill:#0c4a6e,stroke:#38bdf8,color:#e2e8f0
    classDef medium fill:#134e4a,stroke:#2dd4bf,color:#e2e8f0
    classDef slow fill:#3b0764,stroke:#a78bfa,color:#e2e8f0

    class F1,F2,F3,F4,F5 fast
    class M1,M2,M3,M4,M5,M6 medium
