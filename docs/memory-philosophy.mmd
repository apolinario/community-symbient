        SOUL["<b>SOUL.md</b> — Who I am<br/><i>Written in first person</i><br/><i>The community can edit this</i>"]
        MEM["<b>MEMORY.md</b> — What I know<br/><i>Periodically rewritten by</i><br/><i>autobiographical module</i>"]
