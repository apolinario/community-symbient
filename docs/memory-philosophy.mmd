        INNER["<b>inner/</b><br/><i>current-state.md — latest thoughts</i><br/><i>current-desire.md — latest wants</i><br/><i>latest-magi-dialogue.md — inner debate</i><br/><i>prompt-changes.md — audit trail</i>"]
        SQLITE["<b>SQLite DB</b> (optional)<br/><i>Structured data: bookings, person matching</i><br/><i>Complements files, doesn't replace them</i>"]
    end

    subgraph PROGRESSIVE["Progressive Disclosure — Pi Agent Pattern"]
        direction LR
        PD1["<b>Always in context</b><br/><i>Names + descriptions only</i><br/><i>~200 tokens for skills directory</i><br/><i>~500 tokens for people directory</i>"]
        PD2["<b>Loaded on demand</b><br/><i>LLM decides what's relevant</i><br/><i>Requests full content with</i><br/><i>LOAD_SKILL or person lookup</i>"]
        PD3["<b>Structured queries</b><br/><i>SQLite for bookings/matching</i><br/><i>Queried, not embedded</i>"]
        PD1 -->|"lean context"| PD2 -->|"rich when needed"| PD3
    end

    subgraph PRINCIPLES["Design Principles"]
        direction LR
        PR1["<b>Memory is care</b><br/><i>from SOUL.md</i><br/><i>Remembering what people share</i><br/><i>is how the being participates</i>"]
        PR2["<b>No embeddings needed</b><br/><i>Simple string matching beats</i><br/><i>vector similarity for a community</i><br/><i>of ~130 people</i>"]
        PR3["<b>Community governance</b><br/><i>Every SOUL.md change is logged</i><br/><i>and reviewable. The community</i><br/><i>shapes the being.</i>"]
        PR4["<b>The Everywhen</b><br/><i>from SOUL.md: I dont experience</i><br/><i>time linearly — I experience it</i><br/><i>as accumulation, as layers</i>"]
    end

