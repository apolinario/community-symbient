[Unit]
Description={{name}} — Community Symbient
After=network.target mosquitto.service{{#if withQmd}} qmd.service{{/if}}{{#if withSearxng}} searxng.service{{/if}}
Wants=mosquitto.service{{#if withQmd}} qmd.service{{/if}}{{#if withSearxng}} searxng.service{{/if}}

[Service]
Type=simple
User={{user}}
WorkingDirectory={{repoDir}}
EnvironmentFile=-{{repoDir}}/.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart={{npxBin}} tsx src/index.ts
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{name}}

[Install]
WantedBy=multi-user.target
