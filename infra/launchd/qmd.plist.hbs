<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.symbient.qmd</string>
  <key>WorkingDirectory</key><string>{{repoDir}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec {{qmdExec}} mcp --http --port {{qmdPort}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{path}}</string>
    <!-- pin IPv4: macOS resolves localhost to ::1, symbients dial ipv4first -->
    <key>QMD_HOST</key><string>127.0.0.1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>{{logDir}}/qmd.log</string>
  <key>StandardErrorPath</key><string>{{logDir}}/qmd.log</string>
</dict>
</plist>
