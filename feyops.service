[Unit]
Description=FeyOps — Booking Dashboard
After=network.target

[Service]
Type=simple
User=plantoidz
WorkingDirectory=/home/plantoidz/pi/feyblet
EnvironmentFile=/home/plantoidz/pi/feyblet/.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/npx tsx src/feyops/server.ts
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=feyops

[Install]
WantedBy=multi-user.target
