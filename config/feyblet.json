{
  "name": "feyblet",
  "workspacePath": "./workspace",
  "adapters": {
    "chat": {
      "adapter": "signal",
      "params": {
        "account": "+15674026181",
        "httpHost": "127.0.0.1",
        "httpPort": 8080,
        "dmPolicy": "open",
        "groupPolicy": "open",
        "allowFrom": [],
        "groupAllowFrom": []
      }
    },
    "directory": {
      "adapter": "feyops",
      "params": {
        "path": "./data/feyops.db"
      }
    }
  },
  "mcp_servers": [
    { "name": "radio", "url": "http://192.168.10.97:8001/mcp" },
    { "name": "phonebooth", "url": "http://192.168.10.97:3001/mcp" }
  ],
  "mqtt": {
    "brokerUrl": "localhost",
    "port": 1883
  },
  "llm": {
    "provider": "openai",
    "model": "qwen/qwen3.5-27b",
    "baseUrl": "http://localhost:1234"
  },
  "modules": {
    "thinking": { "intervalMs": 10800000 },
    "desire": { "intervalMs": 3600000 },
    "magi": { "intervalMs": 14400000, "startActive": false },
    "autobiographical": { "intervalMs": 21600000, "startActive": false },
    "prompt-modifier": { "intervalMs": 86400000, "startActive": false }
  }
}
