{
  "name": "feyblet",
  "workspacePath": "./workspace",
  "workspace": {
    "writablePaths": ["inner/", "season/"]
  },
  "scheduling": {
    "defaultTarget": "executive"
  },
  "adapters": {
    "chat": {
      "adapter": "signal",
      "params": {
        "account": "+15674026181",
        "httpHost": "127.0.0.1",
        "httpPort": 8080,
        "dmPolicy": "open",
        "groupPolicy": "open",
        "allowFrom": [],
        "groupAllowFrom": []
      }
    },
    "directory": {
      "adapter": "feyops",
      "params": {
        "path": "./data/feyops.db"
      }
    }
  },
  "mcp_servers": [],
  "services": {
    "search": { "url": "http://localhost:8181" },
    "whisper": { "url": "http://localhost:8001" },
    "searxng": { "url": "http://localhost:4000" },
    "tts": { "url": "http://localhost:8000" }
  },
  "mqtt": {
    "brokerUrl": "localhost",
    "port": 1883
  },
  "llm": {
    "provider": "openai",
    "model": "Qwen3.6-35B-A3B-UD-Q4_K_M.gguf",
    "baseUrl": "http://localhost:1234",
    "tinyBaseUrl": "http://localhost:1235",
    "tinyModel": "LFM2.5-VL-1.6B-Q4_0.gguf"
  },
  "modules": {
    "thinking": { "intervalMs": 10800000 },
    "desire": { "intervalMs": 3600000 },
    "magi": { "intervalMs": 14400000, "startActive": false },
    "autobiographical": { "intervalMs": 21600000, "startActive": false },
    "prompt-modifier": { "intervalMs": 86400000, "startActive": false }
  },
  "coder": {
    "reviewer": "Apolinário Passos",
    "repo": "apolinario/community-symbient",
    "worktreeBase": "/tmp/symbient-coder",
    "baseBranch": "alpha-rc"
  }
}
